{
  "name": "serah",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=9.0.0 <10"
  },
  "scripts": {
    "dev": "pnpm --filter @serah/web dev",
    "build": "pnpm --filter @serah/web build",
    "start": "pnpm --filter @serah/web start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @serah/web test:e2e",
    "guard": "node scripts/guard/index.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm guard",
    "db:up": "node scripts/db-up.mjs",
    "db:down": "docker compose down",
    "wt:baru": "node scripts/wt-baru.mjs",
    "wt:hapus": "node scripts/wt-hapus.mjs",
    "teks:periksa": "node scripts/teks-dari-blueprint.ts --periksa"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "pg": "^8.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
