{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @serah/web build"
  },
  "deploy": {
    "preDeployCommand": ["pnpm --filter @serah/db db:migrate"],
    "startCommand": "pnpm --filter @serah/web start",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
