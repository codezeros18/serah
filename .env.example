# Salin ke .env lalu isi. JANGAN commit .env. Rincian tiap variabel ada di komentar berkas ini.

# ── Wajib (aplikasi menolak start bila kosong) ─────────────────────────────
# Role runtime serah_app (bukan superuser, NOBYPASSRLS).
DATABASE_URL=postgresql://serah_app:serah_app_dev@localhost:5432/serah
# Role migrasi serah_migrasi (pemilik tabel).
DATABASE_URL_MIGRASI=postgresql://serah_migrasi:serah_migrasi_dev@localhost:5432/serah
BASE_URL=http://localhost:3000
# Minimal 32 karakter acak. TOKEN_PEPPER jangan diubah setelah ada data.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOKEN_PEPPER=
SESI_SECRET=

# ── Opsional ───────────────────────────────────────────────────────────────
# Port host Postgres Docker lokal (docker-compose). Samakan dengan port di DATABASE_URL*.
SERAH_DB_PORT=5432
PORT=3000
CRON_SECRET=
DEMO_MODE=false
# Hanya bersama DEMO_MODE=true: akun baru langsung terverifikasi tanpa email (untuk juri). Jangan nyalakan di produksi sungguhan.
DAFTAR_LANGSUNG_AKTIF=false
NEXT_PUBLIC_API_MOCK=false

# Foto: lokal | r2 (wajib diisi di produksi)
PENYIMPANAN_MODE=lokal
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Pembacaan tiket. Tanpa kunci: isian manual saja.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_MODEL_CADANGAN=claude-sonnet-5-5

# live | snapshot
BMKG_MODE=snapshot

# Pembayaran mode uji (sandbox) saja. MIDTRANS_IS_PRODUCTION=true → aplikasi menolak start.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
TRANSFER_REKENING_TEKS=

# Email (dev: dicetak ke terminal; produksi: wajib)
RESEND_API_KEY=
EMAIL_FROM=

# Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

SENTRY_DSN=
RETENSI_FOTO_HARI=180
# Wajib di produksi (kebijakan privasi)
EMAIL_KONTAK=
